import { compare } from 'bcrypt-ts';
import NextAuth, { type DefaultSession } from 'next-auth';
import Credentials from 'next-auth/providers/credentials';
import { createGuestUser, getUser } from '@/lib/db/queries';
import { authConfig } from './auth.config';
import { DUMMY_PASSWORD } from '@/lib/constants';
import type { DefaultJWT } from 'next-auth/jwt';
import { isDevelopmentEnvironment } from '@/lib/constants';

export type UserType = 'guest' | 'regular';
export type UserRole = 'user' | 'admin';

declare module 'next-auth' {
  interface Session extends DefaultSession {
    user: {
      id: string;
      type: UserType;
      role: UserRole;
    } & DefaultSession['user'];
  }

  interface User {
    id?: string;
    email?: string | null;
    type: UserType;
    role?: UserRole;
  }
}

declare module 'next-auth/jwt' {
  interface JWT extends DefaultJWT {
    id: string;
    type: UserType;
    role: UserRole;
  }
}

export const {
  handlers: { GET, POST },
  auth,
  signIn,
  signOut,
} = NextAuth({
  ...authConfig,
  debug: true, // Enable debug mode to see detailed logs
  session: {
    strategy: 'jwt',
    maxAge: 30 * 24 * 60 * 60, // 30 days
  },
  cookies: {
    sessionToken: {
      name: `${isDevelopmentEnvironment ? '' : '__Secure-'}next-auth.session-token`,
      options: {
        httpOnly: true,
        sameSite: 'lax',
        path: '/',
        secure: !isDevelopmentEnvironment,
      },
    },
  },
  providers: [
    Credentials({
      credentials: {},
      async authorize({ email, password }: any) {
        try {
          console.log(`Attempting login for email: ${email}`);

          // Get user from database
          const users = await getUser(email);

          if (users.length === 0) {
            console.log(`User not found for email: ${email}`);
            // Adding timing-safe operation to prevent timing attacks
            await compare(password, DUMMY_PASSWORD);
            return null;
          }

          const [user] = users;
          console.log(
            `User found: ${user.id}, Role: ${user.role}, Password length: ${user.password?.length || 0}`,
          );

          if (!user.password) {
            console.log(`User has no password: ${user.id}`);
            await compare(password, DUMMY_PASSWORD);
            return null;
          }

          // Compare passwords
          console.log(`Comparing password for user: ${user.id}`);
          const passwordsMatch = await compare(password, user.password);

          if (!passwordsMatch) {
            console.log(`Password mismatch for user: ${user.id}`);
            return null;
          }

          console.log(
            `Login successful for user: ${user.id}, role: ${user.role || 'user'}`,
          );
          return {
            id: user.id,
            email: user.email,
            type: 'regular',
            role: user.role || 'user',
          };
        } catch (error) {
          console.error('Authorization error:', error);
          return null;
        }
      },
    }),
    Credentials({
      id: 'guest',
      credentials: {},
      async authorize() {
        try {
          console.log('Creating guest user session');
          const [guestUser] = await createGuestUser();
          console.log(`Guest user created: ${guestUser.id}`);
          return { ...guestUser, type: 'guest', role: 'user' };
        } catch (error) {
          console.error('Guest authorization error:', error);
          return null;
        }
      },
    }),
  ],
  callbacks: {
    async jwt({ token, user }) {
      if (user) {
        console.log(
          `Setting JWT for user: ${user.id}, type: ${user.type}, role: ${user.role || 'user'}`,
        );
        token.id = user.id as string;
        token.type = user.type;
        token.role = user.role || 'user';
      }

      return token;
    },
    async session({ session, token }) {
      if (session.user) {
        console.log(
          `Setting session for user ID: ${token.id}, type: ${token.type}, role: ${token.role}`,
        );
        session.user.id = token.id;
        session.user.type = token.type;
        session.user.role = token.role;
      }

      return session;
    },
  },
});
